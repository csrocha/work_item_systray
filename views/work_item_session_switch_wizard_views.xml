<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="work_item_session_switch_wizard_form" model="ir.ui.view">
        <field name="name">work.item.session.switch.wizard.form</field>
        <field name="model">work.item.session.switch.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar de work item">
                <field name="mode" invisible="1"/>
                <sheet>
                    <group string="Work item que dejás" invisible="not current_work_item_ref">
                        <field name="current_work_item_ref" readonly="1"/>
                        <field name="previous_intent_note" readonly="1"
                               invisible="not previous_intent_note"/>
                        <field name="outcome_template_id"/>
                        <field name="outcome_text" nolabel="1" colspan="2"
                               placeholder="¿Qué se logró?"/>
                    </group>

                    <group string="Work item que iniciás" invisible="mode != 'switch'">
                        <field name="target_ref"/>
                        <field name="intent_template_id"/>
                        <field name="intent_text" nolabel="1" colspan="2"
                               placeholder="¿Qué se va a hacer?"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cambiar de work item" name="action_confirm"
                            type="object" class="btn-primary"
                            invisible="mode != 'switch'"/>
                    <button string="Tomar descanso" name="action_confirm"
                            type="object" class="btn-primary"
                            invisible="mode != 'break'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_work_item_session_switch_wizard" model="ir.actions.act_window">
        <field name="name">Cambiar de work item</field>
        <field name="res_model">work.item.session.switch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
