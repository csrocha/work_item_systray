<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_work_item_message_template_list" model="ir.ui.view">
        <field name="name">work.item.message.template.list</field>
        <field name="model">work.item.message.template</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="direction"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="requires_detail"/>
                <field name="sets_blocked"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_work_item_message_template" model="ir.actions.act_window">
        <field name="name">Mensajes de inicio/cierre de work item</field>
        <field name="res_model">work.item.message.template</field>
        <field name="view_mode">tree</field>
        <field name="context">{'default_direction': 'enter'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay plantillas de mensaje definidas aún.
            </p>
            <p>
                Estas plantillas se ofrecen al cambiar de work item desde el
                systray, tanto para describir qué se va a hacer (al entrar)
                como qué se logró (al salir). Las de "Al salir" pueden marcar
                el work item que se deja como bloqueado.
            </p>
        </field>
    </record>
</odoo>
