<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="work_item_systray.WorkItemSystrayItem">
    <Dropdown class="'o_work_item_systray'" menuClass="'o_work_item_systray_menu o_work_item_menu'">
        <t t-set-slot="toggler">
            <span t-attf-class="o_work_item_chip {{ state.cssClass }} {{ state.isPomodoroBlinking ? 'o_work_item_pomodoro_blink' : '' }}">
                <t t-if="state.icon"><t t-esc="state.icon"/> </t>
                <span class="o_work_item_chip_text" t-esc="state.name"/>
            </span>
            <span t-attf-class="o_work_item_chip ms-1 {{ state.timeColorClass }}"
                  title="Tiempo trabajado en la actividad actual">
                ⏱ <t t-esc="state.elapsed"/>
            </span>
        </t>
        <t t-set-slot="default">
            <div class="o_work_item_pomodoro_confirm alert alert-warning py-2 px-3 mb-2" t-if="state.isPomodoroBlinking">
                <div class="mb-1">¿Seguís trabajando en esto?</div>
                <button class="btn btn-sm btn-warning" t-on-click="() => this.onConfirmPomodoro()">
                    Sí, seguir <i class="fa fa-check ms-1"/>
                </button>
            </div>
            <DropdownItem onSelected="() => this.onTakeBreak()">
                <i class="fa fa-pause me-1"/> Descanso
            </DropdownItem>
            <div class="dropdown-divider"/>
            <div class="o_work_item_hint" t-if="state.workItemId">
                <div class="fw-bold mb-1"><t t-esc="state.name"/></div>
                <div class="text-muted small mb-2" t-esc="state.description || 'Sin descripción.'"/>
                <button class="btn btn-sm btn-secondary" t-on-click="() => this.onOpenWorkItem()">
                    Abrir <i class="fa fa-external-link ms-1"/>
                </button>
            </div>
            <div class="dropdown-divider" t-if="state.workItemId"/>
            <t t-if="todayItems.length">
                <div class="dropdown-header text-muted small">Hoy</div>
                <DropdownItem t-foreach="todayItems" t-as="item" t-key="item.model + '_' + item.res_id"
                              class="'o_work_item_list_item'"
                              onSelected="() => this.onSelectWorkItem(item.model, item.res_id)">
                    <span t-attf-class="{{ item.css_class }} o_work_item_list_item_text">
                        <t t-if="item.icon"><t t-esc="item.icon"/> </t>
                        <t t-esc="item.name"/>
                    </span>
                    <i class="fa fa-chevron-right o_work_item_list_item_open"
                       title="Inspeccionar"
                       t-on-click.stop="() => this.openWorkItemRecord(item.model, item.res_id)"/>
                </DropdownItem>
            </t>
            <t t-if="otherItems.length">
                <div class="dropdown-header text-muted small" t-if="todayItems.length">Resto</div>
                <DropdownItem t-foreach="otherItems" t-as="item" t-key="item.model + '_' + item.res_id"
                              class="'o_work_item_list_item'"
                              onSelected="() => this.onSelectWorkItem(item.model, item.res_id)">
                    <span t-attf-class="{{ item.css_class }} o_work_item_list_item_text">
                        <t t-if="item.icon"><t t-esc="item.icon"/> </t>
                        <t t-esc="item.name"/>
                    </span>
                    <i class="fa fa-chevron-right o_work_item_list_item_open"
                       title="Inspeccionar"
                       t-on-click.stop="() => this.openWorkItemRecord(item.model, item.res_id)"/>
                </DropdownItem>
            </t>
            <DropdownItem t-if="!state.workItems.length" class="'text-muted'">
                No hay work items disponibles
            </DropdownItem>
            <div class="dropdown-divider"/>
            <DropdownItem onSelected="() => this.onOpenWizardBlank()">
                ➕ Elegir / crear work item
            </DropdownItem>
        </t>
    </Dropdown>
</t>

</templates>
